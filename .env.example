# Chiave dell'API di Anthropic: serve per leggere i documenti, per la chat e per il memo.
ANTHROPIC_API_KEY=

# Facoltativa. Modello da usare (predefinito: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Stringa di connessione Postgres (Supabase: Connect -> Transaction pooler).
# Senza, i dati finiscono nella cartella data/ (va bene solo in locale).
# DATABASE_URL=

# Password di accesso all'app. Consigliata se la pubblichi online.
# APP_PASSWORD=

# Solo per provare l'app senza chiave: le analisi restituiscono dati finti.
# LLM_MOCK=1
